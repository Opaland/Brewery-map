{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "types": ["node", "vite/client"],
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "vite.config.ts",
    "vitest.stryker.config.ts",
    "playwright.config.ts",
    "build",
    "outils",
    "src/core",
    "src/Contact.tsx",
    "src/Bieres.tsx",
    "src/FiltreType.tsx",
    "src/Horaires.tsx",
    "src/YAller.tsx",
    "src/LienExterne.tsx",
    "src/EnFrancais.tsx",
    "src/EnBref.tsx",
    "src/apercu.ts",
    "src/cacheTuiles.ts",
    "src/ChoixCommune.tsx",
    "src/crochets.ts",
    "src/communesFrance.ts",
    "src/localisation.ts",
    "src/PointDeDepart.tsx",
    "src/nouvelleVersion.ts",
    "src/i18n.ts",
    "src/textes",
    "tests"
  ]
}
