{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/crochet.mjs\" porte-avant-commit",
            "timeout": 600,
            "statusMessage": "Porte avant commit : lint, typecheck, tests, garde de data/, build, e2e…"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/crochet.mjs\" dist-a-jour",
            "timeout": 20,
            "statusMessage": "dist/ est-il à jour ?"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/crochet.mjs\" etat-deploiement",
            "timeout": 30,
            "statusMessage": "État du déploiement de main…"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npx tsc *)",
      "Bash(npx vitest *)",
      "Bash(npx playwright test *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(npm run porte)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(npx tsx outils/curation.ts controler *)",
      "Bash(npx tsx outils/curation.ts diff *)",
      "Bash(npx tsx outils/garde-donnees.ts)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list*)"
    ],
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * +*)",
      "Bash(git push --delete *)",
      "Bash(git reset --hard *)",
      "Bash(git reset --hard)"
    ]
  }
}
